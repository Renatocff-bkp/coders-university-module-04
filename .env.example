# Copy to .env and fill the Supabase keys from `npm run infra:status`.
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Observability (Alloy receives logs on 3101 and OTLP on 4318).
LOKI_URL=http://localhost:3101
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Client (apps/app)
VITE_API_URL=http://localhost:3002

# Auth (apps/api + apps/app)
APP_URL=http://localhost:5173
SESSION_TTL_DAYS=7
EMAIL_FROM=no-reply@coders-university.local

# Auth email delivery (Mailtrap Email Testing in non-production, Resend in production).
MAILTRAP_SMTP_HOST=mailtrap-smtp.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
RESEND_API_KEY=
