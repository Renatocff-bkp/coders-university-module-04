{
  "name": "coders-university-module-04",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev:api": "turbo run dev --filter=api",
    "dev:app": "turbo run dev --filter=app",
    "infra:up": "docker compose --profile full up -d",
    "infra:up:core": "docker compose up -d",
    "infra:up:full": "npm run infra:up",
    "infra:down": "docker compose --profile full down",
    "infra:logs": "docker compose --profile full logs -f",
    "infra:status": "docker compose ps",
    "infra:health": "node scripts/infra-health.mjs",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:reset": "docker compose down -v postgres && docker compose up -d --wait postgres && npm run db:migrate && docker compose exec -T postgres psql -U postgres -d postgres -v ON_ERROR_STOP=1 < db/seed.sql",
    "db:test": "docker compose exec -T postgres psql -U postgres -d postgres -v ON_ERROR_STOP=1 < db/tests/rls.sql",
    "db:generate": "npm run db:generate --workspace=api",
    "loadtest:seed": "node load-tests/seed.mjs",
    "loadtest:check": "node --test load-tests/lib/data.test.mjs",
    "loadtest:smoke": "docker compose --profile loadtest run --rm -e PROFILE=smoke k6",
    "loadtest:load": "docker compose --profile loadtest run --rm -e PROFILE=load k6",
    "loadtest:stress": "docker compose --profile loadtest run --rm -e PROFILE=stress k6",
    "lint:commit": "commitlint --last",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "drizzle-orm": "0.45.4",
    "turbo": "^2.11.5",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
